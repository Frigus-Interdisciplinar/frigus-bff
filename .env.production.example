# Referência para configurar o serviço BFF de PRODUÇÃO no Render, ligado à branch main.
# Configure os valores no painel do Render; não envie este arquivo com segredos.
NODE_ENV=production
# URL pública HTTPS da Core API de produção; trocar pela URL após criar o serviço.
# Se a Core API puder receber tráfego privado (plano pago), e os serviços estiverem
# no mesmo workspace e região, pode usar seu endereço interno (porta 10000).
API_BASE_URL=https://REPLACE_WITH_PRODUCTION_CORE_API_URL
API_TIMEOUT_MS=10000
WEB_ORIGINS=https://REPLACE_WITH_PRODUCTION_FRONTEND_ORIGIN
TRUST_PROXY=true

# Necessários para imagens de perfil e anexos de conversa.
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_PRODUCTION_SUPABASE_SECRET_KEY
SUPABASE_STORAGE_BUCKET=profile-picture
SUPABASE_CHAT_BUCKET=chat-attachments

# Necessários somente para emitir sessões de compra do Firebase.
FIREBASE_PROJECT_ID=REPLACE_WITH_PRODUCTION_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_JSON=REPLACE_WITH_PRODUCTION_FIREBASE_SERVICE_ACCOUNT_JSON
